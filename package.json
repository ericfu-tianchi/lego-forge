{
  "name": "lego-forge",
  "version": "0.1.0",
  "description": "Turn an idea or a picture into a buildable, take-apart-able LEGO set — a toolkit for coding agents.",
  "type": "module",
  "author": "Tianchi Fu",
  "license": "MIT",
  "repository": "github:ericfu-tianchi/lego-forge",
  "bin": { "lego": "bin/lego.mjs" },
  "scripts": {
    "build-viewer": "esbuild viewer/src/viewer.js --bundle --format=iife --minify --outfile=viewer/dist/viewer.js",
    "bake": "node tools/bake.mjs"
  },
  "dependencies": { "three": "0.170.0", "playwright": "^1.48.0" },
  "devDependencies": { "esbuild": "^0.24.0" },
  "engines": { "node": ">=18" },
  "files": ["bin", "engine", "viewer/dist", "viewer/template.html", "templates", "examples", "docs", "AGENTS.md", "SKILL.md", "README.md", "LICENSE"]
}
